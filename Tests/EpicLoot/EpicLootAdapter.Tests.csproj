<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PythonExe Condition="'$(PythonExe)' == ''">python</PythonExe>
  </PropertyGroup>
  <Target Name="ExtractProductionAdapter" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildProjectDirectory)/extract_adapter.py&quot; &quot;$(MSBuildProjectDirectory)/../../FishingRodBagUi.Patches.cs&quot; &quot;$(IntermediateOutputPath)EpicLootBagCompatibility.g.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)EpicLootBagCompatibility.g.cs" /></ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Include="GameStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
